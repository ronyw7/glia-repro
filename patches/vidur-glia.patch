diff --git a/vidur/scheduler/global_scheduler/custom_global_scheduler.py b/vidur/scheduler/global_scheduler/custom_global_scheduler.py
new file mode 100644
index 0000000..7983e72
--- /dev/null
+++ b/vidur/scheduler/global_scheduler/custom_global_scheduler.py
@@ -0,0 +1,35 @@
+import importlib.util
+import inspect
+import os
+import sys
+
+from vidur.scheduler.global_scheduler.base_global_scheduler import BaseGlobalScheduler
+
+
+def load_custom_global_scheduler(config, replicas):
+    """Import `module_path` and instantiate the requested BaseGlobalScheduler subclass."""
+    gs_config = config.cluster_config.global_scheduler_config
+    path = os.path.abspath(gs_config.module_path)
+    mod_name = "custom_gs_" + os.path.splitext(os.path.basename(path))[0]
+    spec = importlib.util.spec_from_file_location(mod_name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[mod_name] = module
+    spec.loader.exec_module(module)
+
+    if gs_config.class_name:
+        cls = getattr(module, gs_config.class_name)
+    else:
+        candidates = [
+            c
+            for _, c in inspect.getmembers(module, inspect.isclass)
+            if issubclass(c, BaseGlobalScheduler)
+            and c is not BaseGlobalScheduler
+            and c.__module__ == mod_name
+        ]
+        if len(candidates) != 1:
+            raise ValueError(
+                f"{path}: expected exactly one BaseGlobalScheduler subclass, found "
+                f"{[c.__name__ for c in candidates]}; set class_name"
+            )
+        cls = candidates[0]
+    return cls(config, replicas)
