diff --git a/vidur/scheduler/global_scheduler/llq_global_scheduler.py b/vidur/scheduler/global_scheduler/llq_global_scheduler.py
new file mode 100644
index 0000000..c145707
--- /dev/null
+++ b/vidur/scheduler/global_scheduler/llq_global_scheduler.py
@@ -0,0 +1,28 @@
+from typing import List, Tuple
+
+from vidur.entities import Request
+from vidur.scheduler.global_scheduler.base_global_scheduler import BaseGlobalScheduler
+
+
+class LLQGlobalScheduler(BaseGlobalScheduler):
+    """
+    Least-loaded queue (LLQ): route each request to the replica with the fewest
+    in-flight requests (pending + active), updating counts as requests are placed.
+    """
+
+    def schedule(self) -> List[Tuple[int, Request]]:
+        self.sort_requests()
+
+        load = {
+            replica_id: rs.num_pending_requests + rs.num_active_requests
+            for replica_id, rs in self._replica_schedulers.items()
+        }
+
+        request_mapping = []
+        while self._request_queue:
+            request = self._request_queue.pop(0)
+            replica_id = min(load.items(), key=lambda x: x[1])[0]
+            load[replica_id] += 1
+            request_mapping.append((replica_id, request))
+
+        return request_mapping
